# librarian configuration, secrets included, set on the container: no image
# has it. On the hosting platform, set each setting in the app's settings.
# Locally, copy this file to librarian/.env and pass it with
# docker run --env-file librarian/.env (orchestrator.py also loads it when run
# outside Docker).

# LLM keys
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=your-model-name
LLM_API_KEY=EMPTY
LLM_REASONING_EFFORT=low

# Questions answered at once; the rest get a 503 and are told to retry.
LIBRARIAN_MAX_CONCURRENT_RUNS=3

# Librarian's core API KEYs
API_KEY=
