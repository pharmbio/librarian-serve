# postgres-db's settings to set on the container, which no image includes: the
# secrets and the deployment's URLs. On the hosting platform, set each of them
# in the app's settings. Locally, copy this file to postgres-db/.env and pass
# it with docker run --env-file postgres-db/.env. Every other setting has its
# default in settings.env, which the image includes, and can be overridden the
# same way.
#
# Each line is read literally: no quotes around values, and no ${VAR}
# references to other variables.

############
# Secrets
#
# Change every one of them before the first start. To generate them all:
#   cd postgres-db && sh utils/generate-keys.sh --update-env
# Documentation:
# https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
#
# The database keeps the passwords from its first start (see SETUP.md).
############

# Postgres: the password of postgres, supabase_admin and the service roles.
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Legacy symmetric HS256 key, and the API keys (JWTs) signed with it.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=
SERVICE_ROLE_KEY=

# Optional asymmetric keys and opaque API keys: see
# https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_JWKS=

# The Studio login, asked for by the gateway.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# Realtime and Supavisor. At least 64 characters: openssl rand -base64 48
SECRET_KEY_BASE=
# Realtime's key for the _realtime schema. Exactly 16 characters: openssl rand -hex 8
REALTIME_DB_ENC_KEY=
# Supavisor's key for its stored configuration. Exactly 32 characters: openssl rand -hex 16
VAULT_ENC_KEY=
# Studio's key for its connection strings to postgres-meta. At least 32 characters: openssl rand -base64 24
PG_META_CRYPTO_KEY=
# Storage's S3 protocol endpoint: openssl rand -hex 16, and openssl rand -hex 32
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Librarian's app reaches its tables through the REST API, with a key for the
# role librarian signed with JWT_SECRET. To print the app's settings for
# app/.env, after generate-keys.sh:  sh utils/librarian-key.sh

############
# URLs: where the gateway (container port 9876) is reached from outside.
# Locally http://localhost:9876; on Serve https://<subdomain>.serve.scilifelab.se
############

SUPABASE_PUBLIC_URL=http://localhost:9876
# Used for OAuth callbacks, SAML endpoints and email links.
API_EXTERNAL_URL=http://localhost:9876/auth/v1
# The site Auth's email links send people back to: the app. Locally
# http://localhost:8080.
SITE_URL=http://localhost:8080
ADDITIONAL_REDIRECT_URLS=

############
# Optional secrets
############

# For the SQL editor's assistant in Studio. Leave empty to turn it off.
OPENAI_API_KEY=
# The login of the mail server Auth sends its emails through (SMTP_HOST in
# settings.env).
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
