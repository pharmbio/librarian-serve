# app configuration. Copy to app/.env and pass it to the container:
#   docker run --env-file app/.env ...
# (main.py also reads it when run outside Docker.)

# Where the other two services are. Inside a container, localhost is the
# container itself, so the defaults (http://localhost:7680 and
# http://localhost:8000) only work when running outside Docker. Pick one:
#
#   On a user-defined Docker network (docker network create repur-net, and run
#   each container with --network repur-net --name <service>):
LIBRARIAN_URL=http://librarian:7680
DB_URL=http://db:8000
#
#   Through ports published on the host (on Linux, also run the app with
#   --add-host=host.docker.internal:host-gateway):
# LIBRARIAN_URL=http://host.docker.internal:7680
# DB_URL=http://host.docker.internal:8000

# The other services' API_KEY values, when they set one. Empty sends no key.
LIBRARIAN_API_KEY=
DB_API_KEY=

# Timeouts, in seconds: for each db call, and for how long the librarian may
# stay silent during a run (it sends a keep-alive every 15 s).
DB_TIMEOUT_S=10
LIBRARIAN_TIMEOUT_S=120

# 1 lets anyone who can reach the app create an account; 0 closes sign-up.
LIBRARIAN_ALLOW_SIGNUP=1
