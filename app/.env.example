# app configuration. Copy to app/.env and pass it to the container:
#   docker run --env-file app/.env ...
# (main.py also reads it when run outside Docker.)

# Where the librarian service is. Inside a container, localhost is the
# container itself, so the default (http://localhost:7680) only works when
# running outside Docker. Pick one:
#
#   On a user-defined Docker network (docker network create repur-net, and run
#   each container with --network repur-net --name <service>):
LIBRARIAN_URL=http://librarian:7680
#
#   Through the port published on the host (on Linux, also run the app with
#   --add-host=host.docker.internal:host-gateway):
# LIBRARIAN_URL=http://host.docker.internal:7680

# The librarian's API_KEY, when it sets one. Empty sends no key.
LIBRARIAN_API_KEY=

# How long the librarian may stay silent during a run, in seconds (it sends a
# keep-alive every 15 s).
LIBRARIAN_TIMEOUT_S=120

# Where the data lives: the Postgres database of the self-hosted Supabase
# (../postgres-db/docker), through its connection pooler in session mode (port
# 5432). Log in as the librarian role, not postgres: its tables stay out of
# Supabase's public REST API. From postgres-db/docker/.env, the user is
# librarian.<POOLER_TENANT_ID> and the password LIBRARIAN_DB_PASSWORD
# (percent-encode any of :/@?# in it). Inside a container, localhost is the
# container itself: for Supabase on the host, use host.docker.internal (on
# Linux, also pass --add-host=host.docker.internal:host-gateway).
DATABASE_URL=postgresql://librarian.<POOLER_TENANT_ID>:<LIBRARIAN_DB_PASSWORD>@host.docker.internal:5432/postgres

# 1 lets anyone who can reach the app create an account; 0 closes sign-up.
LIBRARIAN_ALLOW_SIGNUP=1
