# db service configuration. Copy to db/.env and pass it to the container:
#   docker run --env-file db/.env ...

# Shared secret. When set, every /api/v1 request must send it in the X-API-Key
# header: set the app's DB_API_KEY to the same value. Empty turns auth off; then
# publish the port on 127.0.0.1 only, as this API hands out password hashes.
# Generate one with:  openssl rand -hex 32
API_KEY=

# Where the data lives. The image uses the volume at /data; change this only
# to put the file somewhere else.
# DATABASE_URL=sqlite:////data/librarian.sqlite3
