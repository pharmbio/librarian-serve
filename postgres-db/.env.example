# postgres-db configuration: Supabase's docker/.env.example, minus what only
# Docker Compose used. Copy to postgres-db/.env and pass it to the container:
#   docker run --env-file postgres-db/.env ...
#
# docker run reads each line literally: no quotes around values, and no
# ${VAR} references to other variables.

############
# Secrets
#
# Change every one of them before the first start. To generate them all:
#   cd postgres-db && sh utils/generate-keys.sh --update-env
# Documentation:
# https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase
#
# The database keeps the passwords from its first start (see SETUP.md).
############

# Postgres: the password of postgres, supabase_admin and the service roles.
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Legacy symmetric HS256 key, and the API keys (JWTs) signed with it.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=
SERVICE_ROLE_KEY=

# Optional asymmetric keys and opaque API keys: see
# https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_JWKS=

# The Studio login, asked for by the gateway.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# Realtime and Supavisor. At least 64 characters: openssl rand -base64 48
SECRET_KEY_BASE=
# Realtime's key for the _realtime schema. Exactly 16 characters: openssl rand -hex 8
REALTIME_DB_ENC_KEY=
# Supavisor's key for its stored configuration. Exactly 32 characters: openssl rand -hex 16
VAULT_ENC_KEY=
# Studio's key for its connection strings to postgres-meta. At least 32 characters: openssl rand -base64 24
PG_META_CRYPTO_KEY=
# Storage's S3 protocol endpoint: openssl rand -hex 16, and openssl rand -hex 32
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# The login of Librarian's app, the role librarian (config/db/migrations/
# 99-librarian.sql). Put the same password in the app's DATABASE_URL.
# openssl rand -hex 24
LIBRARIAN_DB_PASSWORD=

############
# URLs: where the gateway (container port 8765) is reached from outside.
# Locally http://localhost:8765; on Serve https://<subdomain>.serve.scilifelab.se
############

SUPABASE_PUBLIC_URL=http://localhost:8765
# Used for OAuth callbacks, SAML endpoints and email links.
API_EXTERNAL_URL=http://localhost:8765/auth/v1

############
# Database
############

POSTGRES_DB=postgres
# Postgres itself, inside the container.
POSTGRES_PORT=5432

############
# Supavisor: the connection pooler
############

# Session mode (5432 in the compose stack, where Postgres had its own
# container) and transaction mode.
POOLER_PROXY_PORT_SESSION=5433
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
# Clients log in through the pooler as <role>.<POOLER_TENANT_ID>.
POOLER_TENANT_ID=librarian-db
POOLER_DB_POOL_SIZE=5

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
# For the SQL editor's assistant. Leave empty to turn it off.
OPENAI_API_KEY=

############
# Auth: https://supabase.com/docs/guides/auth
#
# Any other GOTRUE_* variable reaches Auth unchanged: the OAuth, SMS, MFA,
# SAML and hook settings commented out in Supabase's docker-compose.yml.
############

SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

############
# Storage: files in DATA_DIR/storage/<GLOBAL_S3_BUCKET>
#
# For S3 instead, set STORAGE_BACKEND=s3 and GLOBAL_S3_ENDPOINT,
# GLOBAL_S3_PROTOCOL, GLOBAL_S3_FORCE_PATH_STYLE, AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, as in Supabase's docker-compose.s3.yml.
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true

############
# Edge Functions: the functions/ folder
############

FUNCTIONS_VERIFY_JWT=false

############
# REST API (PostgREST)
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
