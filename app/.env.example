# app configuration, secrets included, set on the container: no image has it.
# On the hosting platform, set each setting in the app's settings. Locally,
# copy this file to app/.env and pass it with docker run --env-file app/.env
# (main.py also loads it when run outside Docker).

# Where the librarian service is. Inside a container, localhost is the
# container itself, so the default (http://localhost:7680) only works when
# running outside Docker. Pick one:
#
#   Through the port published on the host (on Linux, also run the app with
#   --add-host=host.docker.internal:host-gateway):
LIBRARIAN_URL=http://host.docker.internal:7680
#
#   On a user-defined Docker network (docker network create repur-net, and run
#   each container with --network repur-net --name <service>):
# LIBRARIAN_URL=http://librarian:7680

# The librarian's API_KEY, when it sets one. Empty sends no key.
LIBRARIAN_API_KEY=

# How long the librarian may stay silent during a run, in seconds (it sends a
# keep-alive every 15 s).
LIBRARIAN_TIMEOUT_S=120

# Where the data lives: the schema librarian of the Supabase container
# (../postgres-db), reached through its REST API at the gateway's address. On
# Serve, the Supabase app's address: https://<subdomain>.serve.scilifelab.se.
# Inside a container, localhost is the container itself: for the gateway
# published on the host, use host.docker.internal (on Linux, also pass
# --add-host=host.docker.internal:host-gateway).
SUPABASE_URL=http://host.docker.internal:9876

# The two keys, which `sh postgres-db/utils/librarian-key.sh` prints: the anon
# key, which the gateway asks every request for, and the key of the role
# librarian, which reaches only the app's own schema. The second one opens
# every account's data to whoever holds it: keep it secret.
SUPABASE_ANON_KEY=
SUPABASE_LIBRARIAN_KEY=

# 1 lets anyone who can reach the app create an account; 0 closes sign-up.
LIBRARIAN_ALLOW_SIGNUP=1
