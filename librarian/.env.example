# librarian configuration. Copy to librarian/.env: `docker run --env-file
# librarian/.env ...` reads it, and so do main.py and orchestrator.py when run
# outside Docker.

# LLM backend: any OpenAI-compatible /chat/completions endpoint. Inside a
# container, localhost is the container itself: for a server on the host, use
# http://host.docker.internal:8000/v1 (on Linux, also pass
# --add-host=host.docker.internal:host-gateway).
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=your-model-name
LLM_API_KEY=EMPTY
LLM_REASONING_EFFORT=low

# Questions answered at once; the rest get a 503 and are told to retry.
LIBRARIAN_MAX_CONCURRENT_RUNS=2

# Shared secret. When set, /api/v1 requests must send it in the X-API-Key
# header: set the app's LIBRARIAN_API_KEY to the same value. Empty turns auth
# off, which lets anyone who can reach port 7680 spend your LLM credits.
# Generate one with:  openssl rand -hex 32
API_KEY=
