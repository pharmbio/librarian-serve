# librarian configuration, secrets included, set on the container: no image
# has it. On the hosting platform, set each setting in the app's settings.
# Locally, copy this file to librarian/.env and pass it with
# docker run --env-file librarian/.env (orchestrator.py also loads it when run
# outside Docker).

# LLM backend — any OpenAI-compatible /chat/completions endpoint.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=your-model-name
LLM_API_KEY=EMPTY
LLM_REASONING_EFFORT=low
# Hybrid thinking models (Qwen3, etc.): false skips the hidden thinking phase.
# LLM_ENABLE_THINKING=false

# Conversation turns answered at once; the rest get a 503 and are told to retry.
LIBRARIAN_MAX_CONCURRENT_RUNS=3

# Librarian's core API KEYs
API_KEY=

# Turn away questions outside scientific research (code, trivia, jokes, ...)
# with a one-sentence redirect: one extra LLM call per turn. The turn comes back
# as a "reply" with "stopped": true. Off when unset or false.
LIBRARIAN_SCOPE_GUARD=false

# Optional on-disk full-text cache, off when unset. Follow-up questions often
# read the same papers again, and this saves fetching them twice. It also keeps
# the text extracted from supplementary files, when a request asks for them. The image
# includes the `cache` extra it needs; outside Docker, `uv sync --extra cache`.
# Capped at 1 GB. Mount persistent storage there to keep it across restarts.
# LIBRARIAN_CACHE_DIR=/home/librarian-core/cache

# ── Benchmarks only (evals/Literature) ───────────────────────────────────────
# Not needed to run the librarian itself. `literature_eval.sh -h` lists what
# each bench requires.
# OPENAI_API_KEY=      # litqa2, labbench — answering model and open judge
# ANTHROPIC_API_KEY=   # proclaim — both arms use Sonnet 4.6
