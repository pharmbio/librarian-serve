# postgres-db's settings that are no secrets and the same for every
# deployment: Supabase's docker/.env.example, minus the secrets, the
# deployment's URLs (.env.example has those) and what only Docker Compose used.
# The image includes this file, and services/lib.sh loads it. A variable set on
# the container (on the hosting platform, or with docker run -e or --env-file)
# wins over its line here.
#
# Each line is read literally: no quotes around values, and no ${VAR}
# references to other variables.

############
# Database
############

POSTGRES_DB=postgres
# Postgres itself, inside the container.
POSTGRES_PORT=5432

############
# Supavisor: the connection pooler
############

# Session mode (5432 in the compose stack, where Postgres had its own
# container) and transaction mode.
POOLER_PROXY_PORT_SESSION=5433
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
# Clients log in through the pooler as <role>.<POOLER_TENANT_ID>.
POOLER_TENANT_ID=librarian-db
POOLER_DB_POOL_SIZE=5

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

############
# Auth: https://supabase.com/docs/guides/auth
#
# Any other GOTRUE_* variable set on the container reaches Auth unchanged: the
# OAuth, SMS, MFA, SAML and hook settings commented out in Supabase's
# docker-compose.yml.
############

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
# A mail server's login, SMTP_USER and SMTP_PASS, is set on the container.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

############
# Storage: files in DATA_DIR/storage/<GLOBAL_S3_BUCKET>
#
# For S3 instead, set STORAGE_BACKEND=s3 and GLOBAL_S3_ENDPOINT,
# GLOBAL_S3_PROTOCOL, GLOBAL_S3_FORCE_PATH_STYLE, AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY on the container, as in Supabase's
# docker-compose.s3.yml.
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true

############
# Edge Functions: the functions/ folder
############

FUNCTIONS_VERIFY_JWT=false

############
# REST API (PostgREST)
############

# services/rest.sh adds librarian, the schema of Librarian's app.
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
